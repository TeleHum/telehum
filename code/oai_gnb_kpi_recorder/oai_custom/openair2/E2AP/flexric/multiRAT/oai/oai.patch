+} tc_queue_t;
+
+
+// Scheduler
+typedef enum {
+  TC_SCHED_RR,
+  TC_SCHED_PRIO,
+
+  TC_SCHED_END
+} tc_sch_e; 
+
+
+typedef struct{
+  uint32_t dummy;
+//  tc_sch_t base;
+} tc_sch_rr_t; 
+
+typedef struct{
+//  tc_sch_t base;
+  uint32_t len_q_prio;
+  uint32_t* q_prio;
+} tc_sch_prio_t; 
+
+void free_tc_ctrl_sch_prio(tc_sch_prio_t* prio);
+
+tc_sch_prio_t cp_tc_sch_prio(tc_sch_prio_t const*);
