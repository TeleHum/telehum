+} tc_queue_fifo_t;
+
+typedef struct{
+  uint32_t bytes;
+  uint32_t pkts;
+  uint32_t bytes_fwd;
+  uint32_t pkts_fwd;
+  // dropper
+  tc_drp_t drp;
+  float avg_sojourn_time;
