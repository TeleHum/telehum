     printf("[E2 NODE]: mcc = %d mnc = %d mnc_digit = %d nd_id = %d \n", mcc, mnc, mnc_digit_len, nb_id);
 
     int const agent_argc = 1;
     char** agent_argv = NULL;
     fr_args_t ric_args = init_fr_args(agent_argc, agent_argv);
