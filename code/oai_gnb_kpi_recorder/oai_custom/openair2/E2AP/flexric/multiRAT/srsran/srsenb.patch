+                      ${SM_ENCODING_RLC_SRC}
+                      enc/rlc_enc_plain.c 
+                      dec/rlc_dec_plain.c 
+                      )
+
+elseif(SM_ENCODING_RLC STREQUAL "ASN" )
+  message(FATAL_ERROR "RLC SM ASN not implemented")
+  add_subdirectory(ie/asn)
+
+  add_library(rlc_sm SHARED
