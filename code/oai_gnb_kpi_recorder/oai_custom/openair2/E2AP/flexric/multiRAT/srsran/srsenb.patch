+{
+  assert(src != NULL);
+
+  rlc_ind_msg_t cp = {.len = src->len, .tstamp = src->tstamp}; 
+
+  if(cp.len > 0){
+    cp.rb = calloc(cp.len, sizeof(rlc_radio_bearer_stats_t));
+    assert(cp.rb != NULL && "memory exhausted");
+  }
+
+  memcpy(cp.rb, src->rb, sizeof(rlc_radio_bearer_stats_t)*cp.len);
+
