+///////////////
+// E2 Setup
+///////////////
+
+typedef struct{
+  pdcp_func_def_t func_def;
+} pdcp_e2_setup_data_t;
+
+///////////////
+// RIC Service Update
+///////////////
+
+typedef struct{
+  pdcp_func_def_t func_def;
+} pdcp_ric_service_update_t;
+
+#endif
