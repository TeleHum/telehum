+////////////////////////////////////
+// E2 Agent Ctrl Slicing
+// Setting the UEs slice information
+////////////////////////////////////
+
+
+std::vector<sched_ue*> sched::ues_in_slice(uint32_t slice_id)
+{
+  std::vector<sched_ue*> ues; 
+  for(auto it = ue_db.begin(); it != ue_db.end(); ++it){
+    sched_ue& ue = *it->second;  
+
+    if(ue.slice_id() == (int64_t)slice_id){
+      ues.push_back(&ue);
+    }
+  }
+  return ues;
+}
+
+
+void sched::slice_add_mod(slice_conf_t const& conf)
+{
+  size_t const len_slices = conf.dl.len_slices; 
+  assert(len_slices > 0 & len_slices < 4 && "Not a bug if you have more than 4 slices");
+
+  for(size_t i = 0; i < len_slices; ++i){
+    slice_t const& slices = conf.dl.slices[i];
+    assert(slices.params.type == SLICE_ALG_SM_V0_STATIC && "Only static implemented"); 
+    uint32_t const slice_id = slices.id;
+    std::vector<sched_ue*> ues = ues_in_slice(slice_id);
+
+    static_slice_t const& sta = slices.params.sta;
+    assert(sta.pos_low < 14 && sta.pos_high < 14);
+    assert(sta.pos_low <= sta.pos_high);
+
+    size_t const diff = sta.pos_high - sta.pos_low; 
+    size_t const quo = diff / ues.size();
+    int rem = diff % ues.size();
+
+    // Round-Robin sched
+    size_t low_pos = sta.pos_low;
+    for(auto it = std::begin(ues); it < std::end(ues); ++it){
+      size_t extra = rem > 0 ? 1 : 0; 
+      (*it)->set_low_pos(low_pos);
+      (*it)->set_high_pos(low_pos + quo + extra); 
+      low_pos += quo + extra;
+      rem -=1;
+    }
+    assert(low_pos == sta.high_pos);
+  }
+}
+
+void sched::ue_slice_conf(ue_slice_conf_t const& ue_slice)
+{
+  for(size_t i = 0; i < ue_slice.len_ue_slice; ++i){
+    ue_slice_assoc_t* ue_s = &ue_slice.ues[i]; 
+    for(auto it = std::begin(ue_db); it != std::end(ue_db); ++it){
+      sched_ue& ue = *it->second;  
+      if(ue.get_rnti() == ue_s->rnti){
+        assert(ue_s->dl_id < 5 && "Not a bug if you have more than 5 slices");
+        ue.set_slice_id(ue_s->dl_id);
+      }
+    }
+  }
+}
+
+void sched::slice(slice_ctrl_req_data_t const& s)
+{
+     assert(s.msg.type == SLICE_CTRL_SM_V0_ADD ||
+            s.msg.type == SLICE_CTRL_SM_V0_UE_SLICE_ASSOC);
+
+  if(s.msg.type == SLICE_CTRL_SM_V0_ADD){
+    slice_add_mod(s.msg.add_mod_slice); 
+  } else if(s.msg.type == SLICE_CTRL_SM_V0_UE_SLICE_ASSOC){
+    ue_slice_conf(s.msg.ue_slice); 
+  } else {
+    assert(0!=0 &&  "Unknonw data path");
+  }
+
+}
+
+
+
 } // namespace srsenb
