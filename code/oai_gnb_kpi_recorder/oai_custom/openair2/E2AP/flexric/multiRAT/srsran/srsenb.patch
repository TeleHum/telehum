+
+
+//////////////////////////////////////
+// RIC Call Process ID 
+/////////////////////////////////////
+
+typedef struct {
+  uint32_t dummy;
+} mac_call_proc_id_t;
+
+void free_mac_call_proc_id( mac_call_proc_id_t* src); 
+
