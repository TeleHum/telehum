+///////////////
+
+typedef struct{
+  mac_ctrl_hdr_t hdr;
+  mac_ctrl_msg_t msg;
+} mac_ctrl_req_data_t;
+
+typedef struct{
+  mac_ctrl_out_t* out;
+} mac_ctrl_out_data_t;
+
+///////////////
+// E2 Setup
+///////////////
+
+typedef struct{
+  mac_func_def_t func_def;
+} mac_e2_setup_data_t;
+
+///////////////
+// RIC Service Update
+///////////////
+
+typedef struct{
+  mac_func_def_t func_def;
+} mac_ric_service_update_t;
+
+#endif
