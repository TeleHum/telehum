+  uint32_t dummy;
+} mac_func_def_t;
+
+void free_mac_func_def( mac_func_def_t* src); 
+
+mac_func_def_t cp_mac_func_def(mac_func_def_t* src);
+
+bool eq_mac_func_def(mac_func_def_t* m0, mac_func_def_t* m1);
+
+
