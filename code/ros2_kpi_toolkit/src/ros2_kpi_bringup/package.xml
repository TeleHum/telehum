<?xml version="1.0"?>
<package format="3">
  <name>ros2_kpi_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the ROS 2 KPI toolkit.</description>
  <maintainer email="anonymous@example.com">Anonymous Authors</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2_kpi_collector</exec_depend>
  <exec_depend>ros2_kpi_exporter</exec_depend>
  <exec_depend>ros2_kpi_probe</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

